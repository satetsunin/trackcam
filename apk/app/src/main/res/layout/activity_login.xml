<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="@color/primary"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="@string/login_subtitulo"
            android:textSize="13sp" />

        <!-- PASO 1: URL base del servidor -->
        <TextView
            style="@style/Label"
            android:text="@string/lbl_url" />

        <EditText
            android:id="@+id/etUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:autofillHints="url"
            android:hint="@string/hint_url"
            android:inputType="textUri"
            android:singleLine="true" />

        <!-- PASO 2: Autenticación Cloudflare (navegador integrado) -->
        <TextView
            style="@style/Label"
            android:layout_marginTop="14dp"
            android:text="@string/lbl_paso_cf" />

        <Button
            android:id="@+id/btnCf"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_autenticar_cf"
            android:textAllCaps="false" />

        <TextView
            android:id="@+id/tvCfEstado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/cf_pendiente"
            android:textColor="@color/warn_red"
            android:textSize="12sp" />

        <!-- PASO 3: Usuario y contraseña del servidor -->
        <TextView
            style="@style/Label"
            android:layout_marginTop="14dp"
            android:text="@string/lbl_paso_login" />

        <EditText
            android:id="@+id/etUser"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:autofillHints="username"
            android:hint="@string/hint_usuario"
            android:inputType="text"
            android:singleLine="true" />

        <EditText
            android:id="@+id/etPass"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:autofillHints="password"
            android:hint="@string/hint_password"
            android:imeOptions="actionDone"
            android:inputType="textPassword"
            android:singleLine="true" />

        <!-- Error del login -->
        <TextView
            android:id="@+id/tvError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="@color/warn_red"
            android:textSize="14sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnLogin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/btn_login" />

    </LinearLayout>
</ScrollView>
