<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Red -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Wifi (contexto que viaja con cada punto):
         - ACCESS_WIFI_STATE: leer el SSID conectado y getScanResults().
         - CHANGE_WIFI_STATE:   startScan() (el escaneo periódico de la huella).
         - ACCESS_FINE_LOCATION (ya declarado arriba): startScan() y
           getScanResults() lo EXIGEN en Android 10+ aunque la app solo quiera
           el SSID/huella; por eso se mantiene sin maxSdkVersion.
         - NEARBY_WIFI_DEVICES (API 33+): obligatorio declararlo si se llama a
           cualquier API de wifi con targetSdk 33+. NO se marca con
           usesPermissionFlags="neverForLocation" porque el SSID/huella sí se
           usan como contexto de localización (y con el flag el sistema
           dejaría de aceptar ACCESS_FINE_LOCATION para el escaneo). -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES" />

    <!-- Ubicación -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <!-- Detección de actividad (acelerómetro): still/walk/run/bike/vehicle/tilt.
         - android.permission.ACTIVITY_RECOGNITION: permiso de runtime en Android 10+ (API 29+).
         - com.google.android.gms.permission.ACTIVITY_RECOGNITION: permiso NORMAL que
           usaba Google Play Services en Android ≤9 (se concede al instalar, sin diálogo). -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <uses-permission android:name="com.google.android.gms.permission.ACTIVITY_RECOGNITION" />

    <!-- Servicio en primer plano 24/7 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Notificaciones (API 33+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Reinicio tras boot -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Optimización de batería -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Instalación OTA (actualizar la app desde el servidor) -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.TrackCam"
        android:usesCleartextTraffic="true">

        <!-- Pantalla de login (F5): es el launcher. Si no hay token guardado
             o la sesión caduca (401) la app arranca/regresa aquí. -->
        <activity
            android:name=".LoginActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:launchMode="singleTop" />

        <!-- Navegador integrado para el SSO de Cloudflare Access -->
        <activity
            android:name=".AuthWebViewActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <!-- FileProvider para instalar la APK descargada por OTA -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!--
            Servicio en primer plano de tipo "location":
            - foregroundServiceType="location" es OBLIGATORIO para targetSdk 34.
            - stopWithTask="false": sigue vivo aunque se deslice la app del
              selector de recientes (crítico para trackeo 24/7).
        -->
        <service
            android:name=".TrackService"
            android:exported="false"
            android:foregroundServiceType="location"
            android:stopWithTask="false" />

        <!-- F5.31 — Despierta la app cuando Android la tiene dormida (Doze).
             Es el mecanismo que Android reserva para salir de Doze; no lleva
             filtro de intent porque la manda la propia app (exported=false). -->
        <receiver
            android:name=".AlarmReceiver"
            android:exported="false" />

        <!-- Relanza el servicio al arrancar el teléfono o tras actualizar la app -->
        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
